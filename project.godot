; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Arunika Studio"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/quit_on_go_back.android=false

[autoload]

GameSettings="*res://scripts/core/game_settings.gd"
MenuAudio="*res://scripts/ui/menu_audio.gd"
SaveManager="*res://scripts/core/save_manager.gd"
WindowControls="*res://scripts/ui/window_controls.gd"
MobileInput="*res://scripts/ui/mobile_input.gd"

[display]

window/size/viewport_width=1672
window/size/viewport_height=941
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/themes/pixelify.tres"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.09, 0.13, 0.21, 1)
renderer/rendering_method.android="gl_compatibility"
limits/opengl/max_renderable_lights.android=8
limits/opengl/max_lights_per_object.android=4
